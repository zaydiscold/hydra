# Hydra Server Config
PORT=3001
JWT_SECRET=your-secure-dev-secret-here

# How long the Hydra master lock-screen session lasts (browser keeps token in localStorage).
# jsonwebtoken `expiresIn` string, e.g. 8h, 24h, 7d (default in code is 24h if unset).
# HYDRA_MASTER_JWT_TTL=24h

# Database
# If using a different SQLite path, update it here
DATABASE_URL="file:./prisma/dev.db"

# Docker / container runtime
# Use the persisted volume path from docker-compose so SQLite and Hydra's local data files
# (for example local-secrets.json and redemption-log.json) survive container restarts.
# DATABASE_URL="file:/app/data/hydra.db"
# JWT_SECRET=change-me-before-running-in-a-shared-environment

# OpenRouter upstream (Clerk session validation uses OR_BASE for /api/v1/credits)
# OR_BASE=https://openrouter.ai

# Clerk FAPI browser-parity headers (defaults match openrouter.ai dashboard)
# CLERK_ORIGIN=https://openrouter.ai
# CLERK_REFERER=https://openrouter.ai/sign-in

# OTP / session debugging: logs Set-Cookie names and Clerk payload hints (no cookie values).
# Also adds clerkDebugOtp + clerkDebugHint to AccountController error JSON (login, otp/start,
# otp/verify, detect-auth, refresh) so the UI can point operators at [CLERK_DEBUG_OTP] log lines.
# CLERK_DEBUG_OTP=1

# Email Link cannot be self-enabled for OpenRouter accounts. OpenRouter owns its
# Clerk tenant and rejects Hydra localhost and arbitrary tunnel callbacks. Only
# set both values for an owner-controlled Clerk tenant after its owner has
# allowlisted the HTTPS relay and the relay forwards /api/auth/magic-callback to
# the running Hydra API. OTP needs neither.
# HYDRA_MAGIC_LINK_CALLBACK_ORIGIN=https://allowlisted-relay.example
# HYDRA_MAGIC_LINK_CALLBACK_ALLOWLIST_CONFIRMED=1

# Management-key provisioning fallback uses Playwright (headless Chromium) against the OpenRouter dashboard.
# HYDRA_PLAYWRIGHT_HEADED=1   # show browser window (local debugging)
# HYDRA_PLAYWRIGHT_CHANNEL=chrome   # optional: use system Chrome instead of bundled Chromium (less bot friction)
# HYDRA_PLAYWRIGHT_CDP_ENDPOINT=http://127.0.0.1:9222   # optional: attach Playwright to your Chrome (remote debugging) instead of launching Chromium
# HYDRA_PROVISION_DEBUG=1    # Playwright trace on failure (provision-trace-*.zip), stderr diagnostics, network log path; screenshots in NODE_ENV=development too
# HYDRA_PROVISION_VERBOSE=1  # step-level stderr during Playwright provision (goto URL/title, create click, after save); redundant in NODE_ENV=development (step logs default on)
# HYDRA_PROVISION_NETWORK_LOG=1  # POST URL/status/postData lines to $TMPDIR/hydra-provision-debug/provision-network-*.log
# HYDRA_PROVISION_SERVER_ACTION_REPLAY=1  # legacy diagnostics marker; direct replay is always attempted
# HYDRA_MGMT_KEY_SERVER_ACTION_ID=abc123def456  # optional override; UI fallback learns drifted Next-Action IDs automatically

# Account Generator opens an isolated visible browser by default so you can
# complete upstream human verification during new signup. Existing-account
# OTP imports remain direct HTTPS and do not use this browser.
# HYDRA_GENERATOR_HEADLESS=1  # hide the signup browser on CI/servers

# ── #2: macOS code-signing + notarization (electron-builder afterSign) ──
# All three must be set together; missing any one skips notarization with a warning.
# APPLE_ID=you@example.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx   # https://appleid.apple.com → Security
# APPLE_TEAM_ID=ABCDE12345                          # 10-char Team ID from Apple Developer portal
# HYDRA_SKIP_NOTARIZE=1                             # silences the "missing env vars" warning

# ── #9: opt-in crash telemetry (Sentry) ──
# Without this DSN, telemetry is a no-op even if the user toggles it on.
# HYDRA_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
