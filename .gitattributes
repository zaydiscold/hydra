# Normalize all text files to LF in the repo and on checkout, on every OS.
# Without this, Windows checkouts (core.autocrlf=true) get CRLF, which breaks
# source/lockfile substring assertions in the test suite (ui-static CSS
# selectors, audit.js package-lock checks) and produces noisy cross-platform diffs.
* text=auto eol=lf

# Windows-native script formats stay CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets — never normalize.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.icns binary
*.webp binary
*.zip  binary
*.gz   binary
*.db   binary
*.node binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.mp4   binary
